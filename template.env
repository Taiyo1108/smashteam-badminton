# Database Connection (Supabase/PostgreSQL)
DATABASE_URL=postgresql://username:password@host:port/database

# JWT Secret for Token Signing
JWT_SECRET=your_jwt_secret_here

# Backend Server Port
PORT=5000

# Club Verification PIN for Old Members Account Activation
CLUB_VERIFY_PIN=123456

# ImageKit Credentials (for Media Management - thay Cloudinary)
# Lấy tại https://imagekit.io/dashboard/developer/api-keys
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_endpoint_id

# Frontend URL (Dùng cho CORS và đường dẫn Email)
FRONTEND_URL=https://smashteam.id.vn

# Background Music URL (BGM) - Optional, falls back to synthwave loop if not defined
# VD dùng ImageKit: https://ik.imagekit.io/your_endpoint_id/bgm.mp3
NEXT_PUBLIC_BGM_URL=

# ==========================================
# CẤU HÌNH GỬI EMAIL (RESEND)
# ==========================================
# Khóa API của Resend (Đăng ký miễn phí tại https://resend.com)
# Hãy đảm bảo bạn đã thêm tên miền smashteam.id.vn vào Resend và xác thực (Verify) để có thể gửi email từ no-reply@smashteam.id.vn
RESEND_API_KEY=re_your_api_key_here
